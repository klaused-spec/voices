# Porta do servidor
PORT=3100

# Token de autenticação (mesmo que o .env.php)
AUTH_TOKEN=seu_token_aqui

# Voz e modelo padrão
DEFAULT_VOICE=Kore
DEFAULT_MODEL=gemini-2.5-flash-preview-tts

# Cache em memória
CACHE_TTL=604800
MAX_CACHE_ENTRIES=500

# API Keys — adicione quantas tiver
GEMINI_API_KEY=
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=
